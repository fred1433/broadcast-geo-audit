#!/bin/zsh
# Full rebuild from data/raw: load, model, functions, audit. Any failure stops the run with a non-zero status.
set -euo pipefail
cd "$(dirname "$0")/.."
export PGOPTIONS="-c client_min_messages=warning"
PY=${PYTHON:-./.venv/bin/python}
./etl/01_load_census.sh
$PY etl/02_load_fcc_acs.py
for f in sql/10_model.sql sql/20_functions.sql sql/zones.sql sql/30_oakland_audit.sql sql/40_audit_decisions.sql; do
  echo "== $f"
  bin/q -f $f
done
echo rebuilt
